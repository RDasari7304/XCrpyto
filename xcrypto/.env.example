# ---------------------------------------------------------------- core
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Where the frontend is served from. In production this equals BASE_URL,
# because the API serves the built frontend on the same origin.
WEB_ORIGIN=http://localhost:5173
# Set true in production to serve web/dist from this process.
SERVE_WEB=false

DATABASE_URL=postgres://postgres:postgres@localhost:5432/xcrypto
# Managed Postgres: append ?sslmode=require and TLS is enabled automatically.

# openssl rand -base64 32    (or: npm run keys)
SESSION_PEPPER=

# ------------------------------------------------------------------- X
# Optional. Without these the API still boots; X sign-in and the mention
# poller are unavailable. Callback must be exactly $BASE_URL/auth/callback
# OAuth 2.0 (user sign-in). Callback = $BASE_URL/auth/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Bearer token used to READ mentions and look up handles. Use the app's
# OAuth 2.0 Access Token, or an App-Only Bearer Token.
X_BOT_TOKEN=
X_BOT_USER_ID=
X_BOT_HANDLE=XCryptoBot

# OAuth 1.0a User Context, used only to POST replies as the bot.
# These are the app's "OAuth 1.0 Keys": API Key/Secret + Access Token/Secret.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# -------------------------------------------------------------- solana
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Escrow = tips to people who have not connected a wallet yet. Requires the
# on-chain program to be built, tested and deployed. Leave false until then:
# direct tips to registered recipients work either way.
ESCROW_ENABLED=false

# Only needed when ESCROW_ENABLED=true.
ESCROW_PROGRAM_ID=
# Identity oracle key. Cannot move funds alone — on-chain claims also require
# the recipient's wallet signature. Generate with: npm run keys
ATTESTOR_SECRET_KEY=

# -------------------------------------------------------------- limits
MIN_TIP_LAMPORTS=1000000
MAX_TIP_LAMPORTS=5000000000

# ----------------------------------------------------------- local only
# Enables GET /auth/dev-login, a complete auth bypass for testing without an X
# app. The route does not exist when NODE_ENV=production, and the server
# refuses to boot if this is set with a non-local BASE_URL. Never set in prod.
ALLOW_DEV_LOGIN=true

# How often the worker polls X for mentions, in seconds. Each poll is a
# billable read on Pay-Per-Use. Default 60. Raise it to spend less.
MENTION_POLL_SECONDS=60
